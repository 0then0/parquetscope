{
  "name": "parquetscope-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/offline.mjs",
    "check": "biome check . && tsc -b",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "26.6.5",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "@biomejs/biome": "2.5.15",
    "vitest": "5.0.5",
    "@playwright/test": "1.64.1"
  }
}
