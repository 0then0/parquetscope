{
  "$defs": {
    "BoundColumn": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 255,
          "title": "Name",
          "type": "string"
        },
        "type": {
          "maxLength": 255,
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "title": "BoundColumn",
      "type": "object"
    },
    "Capture": {
      "additionalProperties": false,
      "properties": {
        "complete": {
          "title": "Complete",
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "reconciled": {
          "title": "Reconciled",
          "type": "boolean"
        },
        "scope": {
          "default": "Input binding and one fully consumed SELECT; app metadata reads excluded.",
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "complete",
        "reason",
        "reconciled"
      ],
      "title": "Capture",
      "type": "object"
    },
    "Engine": {
      "additionalProperties": false,
      "description": "Effective engine conditions. Missing values are null, never guessed.",
      "properties": {
        "httpfs_version": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Httpfs Version"
        },
        "effective_settings": {
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 32,
          "title": "Effective Settings",
          "type": "object"
        },
        "bound_schema": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/BoundColumn"
              },
              "maxItems": 1024,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Bound Schema"
        }
      },
      "required": [
        "httpfs_version",
        "effective_settings",
        "bound_schema"
      ],
      "title": "Engine",
      "type": "object"
    },
    "FileHTTPObservation": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "method": {
          "enum": [
            "GET",
            "HEAD"
          ],
          "title": "Method",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "requested_range": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Requested Range"
        },
        "requested_span": {
          "anyOf": [
            {
              "$ref": "#/$defs/Span"
            },
            {
              "type": "null"
            }
          ]
        },
        "response_span": {
          "anyOf": [
            {
              "$ref": "#/$defs/Span"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "maximum": 599,
          "minimum": 100,
          "title": "Status",
          "type": "integer"
        },
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "number"
        },
        "duration_ms": {
          "minimum": 0,
          "title": "Duration Ms",
          "type": "number"
        },
        "declared_body_bytes": {
          "anyOf": [
            {
              "pattern": "^(0|[1-9][0-9]{0,39})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Declared Body Bytes"
        },
        "request_headers": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Request Headers",
          "type": "object"
        },
        "response_headers": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Response Headers",
          "type": "object"
        },
        "engine_start_time": {
          "title": "Engine Start Time",
          "type": "string"
        },
        "file_id": {
          "pattern": "^f[0-9]{3}$",
          "title": "File Id",
          "type": "string"
        },
        "phase": {
          "enum": [
            "view_creation",
            "select",
            "unattributed"
          ],
          "title": "Phase",
          "type": "string"
        }
      },
      "required": [
        "id",
        "method",
        "url",
        "requested_range",
        "requested_span",
        "response_span",
        "status",
        "start_ms",
        "duration_ms",
        "declared_body_bytes",
        "request_headers",
        "response_headers",
        "engine_start_time",
        "file_id",
        "phase"
      ],
      "title": "FileHTTPObservation",
      "type": "object"
    },
    "FileInput": {
      "additionalProperties": false,
      "description": "One resolved file. `name` is the basename; `logical_path` is the manifest location.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size": {
          "pattern": "^(0|[1-9][0-9]{0,39})$",
          "title": "Size",
          "type": "string"
        },
        "rows": {
          "pattern": "^(0|[1-9][0-9]{0,39})$",
          "title": "Rows",
          "type": "string"
        },
        "row_groups": {
          "minimum": 0,
          "title": "Row Groups",
          "type": "integer"
        },
        "schema_fields": {
          "items": {
            "type": "string"
          },
          "title": "Schema Fields",
          "type": "array"
        },
        "structures": {
          "items": {
            "$ref": "#/$defs/Structure"
          },
          "maxItems": 100000,
          "title": "Structures",
          "type": "array"
        },
        "id": {
          "pattern": "^f[0-9]{3}$",
          "title": "Id",
          "type": "string"
        },
        "logical_path": {
          "maxLength": 1024,
          "title": "Logical Path",
          "type": "string"
        },
        "partition": {
          "items": {
            "$ref": "#/$defs/PartitionSegment"
          },
          "maxItems": 31,
          "title": "Partition",
          "type": "array"
        }
      },
      "required": [
        "name",
        "sha256",
        "size",
        "rows",
        "row_groups",
        "schema_fields",
        "structures",
        "id",
        "logical_path",
        "partition"
      ],
      "title": "FileInput",
      "type": "object"
    },
    "FileMetrics": {
      "additionalProperties": false,
