        "head_count",
        "requested_range_bytes",
        "confirmed_range_bytes",
        "declared_body_bytes",
        "server_written_bytes",
        "unique_coverage_bytes",
        "repeated_coverage_bytes",
        "coverage",
        "unknown_reasons"
      ],
      "title": "FileMetrics",
      "type": "object"
    },
